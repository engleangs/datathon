# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.
project                    = "nzdc"
env                        = "dev"
owner                      = "simon"
aws_region                 = "ap-southeast-2"
budget_alert_email         = "you@example.com"

snowflake_organization     = "ABCDEFG"
snowflake_account          = "XY12345"
snowflake_user             = "TERRAFORM_SVC"
snowflake_private_key_path = "~/.ssh/snowflake_tf_key.p8"

snowflake_monthly_credit_quota = 20
analyst_users                  = []
