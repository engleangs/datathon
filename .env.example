# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
APP_PORT=8501
APP_BIND=0.0.0.0

# ------------------------------------------------------------------
# AWS / Amazon Bedrock
# ------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2

# Set this to a Bedrock model ID or inference profile available to you.
# Prefer a regional option when your data-residency requirements require it.
BEDROCK_MODEL_ID=

# MVP option for an OVH host.
# Do not commit real values. Prefer temporary credentials for production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ------------------------------------------------------------------
# Snowflake
# ------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=NZ_COURT_INTELLIGENCE
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=

# Named administrator connection in ~/.snowflake/connections.toml, used only
# by scripts/provision_ingestion_agent.py. Keep admin credentials out of .env.
SNOWFLAKE_ADMIN_CONNECTION=default

# Streamlit in Snowflake embedding. Keep the PAT secret and never expose it
# in browser-side code or commit it to source control.
SNOWFLAKE_ACCOUNT_URL=https://myorganization-myaccount.snowflakecomputing.com
SNOWFLAKE_EMBED_PAT=
SNOWFLAKE_EMBED_ROLE=STREAMLIT_EMBED_ROLE
STREAMLIT_DATABASE=DATATHON_TEST
STREAMLIT_SCHEMA=COURTLENS
STREAMLIT_APP=TESTCOURTDASHBOARD
PARENT_ORIGIN=https://example.com

# dbt output schema
DBT_TARGET_SCHEMA=ANALYTICS
