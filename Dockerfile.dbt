FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-dbt.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-dbt.txt

COPY dbt_nz_court ./dbt_nz_court

WORKDIR /app/dbt_nz_court

CMD ["dbt", "build", "--profiles-dir", "/app/dbt_nz_court"]
