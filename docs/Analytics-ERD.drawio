        <mxCell id="an-273" parent="1" vertex="1" value='&lt;b&gt;NZ court judgments - analytics model (dbt marts)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="background-color:#dae8fc"&gt;&amp;nbsp;Blue&amp;nbsp;&lt;/span&gt; dimension &amp;nbsp; &lt;span style="background-color:#fff2cc"&gt;&amp;nbsp;Yellow&amp;nbsp;&lt;/span&gt; fact / detail &amp;nbsp; &lt;span style="background-color:#d5e8d4"&gt;&amp;nbsp;Green&amp;nbsp;&lt;/span&gt; bridge (many-to-many)&lt;br&gt;&lt;br&gt;All tables are dbt views built from stg_case_extractions.&lt;br&gt;Keys are MD5 hashes of cleaned values; PK / FK / UQ are checked by dbt tests,&lt;br&gt;not enforced by Snowflake.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;rounded=0;strokeColor=#999999;"><mxGeometry x="0" y="1000" width="480" height="150" as="geometry"></mxGeometry></mxCell>
